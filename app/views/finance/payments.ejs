<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <main class="main-content">
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">All Payments</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle">
                        <span data-feather="calendar"></span>
                        Filter
                    </button>
                </div>
            </div>

            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Transaction ID</th>
                            <th scope="col">Student</th>
                            <th scope="col">Course</th>
                            <th scope="col">Amount</th>
                            <th scope="col">Method</th>
                            <th scope="col">Status</th>
                            <th scope="col">Date</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (payments && payments.length> 0) { %>
                            <% payments.forEach((payment, index)=> { %>
                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= payment.transaction_id || 'N/A' %>
                                    </td>
                                    <td>
                                        <%= payment.student_name %>
                                    </td>
                                    <td>
                                        <%= payment.course_title %>
                                    </td>
                                    <td>$<%= Number(payment.amount).toFixed(2) %>
                                    </td>
                                    <td>
                                        <%= payment.payment_method %>
                                    </td>
                                    <td>
                                        <span
                                            class="badge rounded-pill bg-<%= payment.status === 'completed' ? 'success' : (payment.status === 'refunded' ? 'warning' : 'danger') %>">
                                            <%= payment.status.charAt(0).toUpperCase() + payment.status.slice(1) %>
                                        </span>
                                    </td>
                                    <td>
                                        <%= new Date(payment.created_at).toLocaleDateString() %>
                                    </td>
                                    <td>
                                        <% if (payment.status==='completed' ) { %>
                                            <button class="btn btn-sm btn-outline-danger"
                                                onclick="initiateRefund('<%= payment.id %>')">Refund</button>
                                            <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="9" class="text-center py-4">No payments found.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (pagination.total> pagination.limit) { %>
                <nav aria-label="Payment pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <% const totalPages=Math.ceil(pagination.total / pagination.limit); %>
                            <% for(let i=1; i <=totalPages; i++) { %>
                                <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                    <a class="page-link" href="/finance/payments?page=<%= i %>">
                                        <%= i %>
                                    </a>
                                </li>
                                <% } %>
                    </ul>
                </nav>
                <% } %>
        </main>

        <!-- Refund Modal -->
        <div class="modal fade" id="refundModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Process Refund</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="refundForm">
                            <input type="hidden" id="refundPaymentId">
                            <div class="mb-3">
                                <label for="refundReason" class="form-label">Reason for Refund</label>
                                <textarea class="form-control" id="refundReason" required></textarea>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-danger" onclick="submitRefund()">Confirm Refund</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            const refundModal = new bootstrap.Modal(document.getElementById('refundModal'));

            function initiateRefund(paymentId) {
                document.getElementById('refundPaymentId').value = paymentId;
                refundModal.show();
            }

            async function submitRefund() {
                const paymentId = document.getElementById('refundPaymentId').value;
                const reason = document.getElementById('refundReason').value;

                if (!reason) {
                    alert('Please provide a reason');
                    return;
                }

                try {
                    const response = await fetch(`/finance/payments/${paymentId}/refund`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason })
                    });

                    const result = await response.json();

                    if (response.ok) {
                        alert('Refund processed successfully');
                        location.reload();
                    } else {
                        alert(result.error || 'Refund failed');
                    }
                } catch (error) {
                    console.error(error);
                    alert('Error processing refund');
                }
            }
        </script>

        <%- include('../partials/footer') %>